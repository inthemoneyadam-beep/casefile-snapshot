{
  "name": "casefile",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local-first medical case-management ledger for one case.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "setup": "npm install && node scripts/setup.mjs",
    "dev": "concurrently -k -n api,web -c blue,green \"tsx watch --clear-screen=false src/server/index.ts\" \"vite --clearScreen false\"",
    "build": "vite build",
    "start": "npm run build && cross-env NODE_ENV=production tsx src/server/index.ts",
    "serve": "cross-env NODE_ENV=production tsx src/server/index.ts",
    "typecheck": "tsr generate && tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "backup": "tsx scripts/backup.ts",
    "restore": "tsx scripts/restore.ts",
    "seed": "tsx scripts/seed.ts",
    "routes:gen": "tsr generate",
    "deploy:check": "tsx scripts/deploy-ignore.ts",
    "smoke:hosted": "node --import tsx scripts/container-smoke.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/newsreader": "^5.3.0",
    "@hono/node-server": "^2.1.3",
    "@hono/zod-validator": "^0.7.0",
    "@tanstack/react-query": "^5.90.0",
    "@tanstack/react-router": "^1.130.0",
    "@tanstack/react-table": "^8.21.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "archiver": "^7.0.1",
    "better-sqlite3": "^13.0.3",
    "better-sqlite3-multiple-ciphers": "^13.0.3",
    "cmdk": "^1.1.1",
    "dicom-parser": "^1.8.21",
    "drizzle-orm": "^0.45.3",
    "extract-zip": "^2.0.1",
    "hono": "^4.13.13",
    "mammoth": "^1.13.0",
    "mupdf": "^1.28.1",
    "papaparse": "^5.7.0",
    "pdf-lib": "^1.17.1",
    "puppeteer-core": "^24.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tesseract.js": "^7.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tanstack/router-cli": "^1.167.40",
    "@tanstack/router-plugin": "^1.130.0",
    "@types/archiver": "^6.0.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.0.0",
    "@types/papaparse": "^5.3.16",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "drizzle-kit": "^0.31.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  }
}
